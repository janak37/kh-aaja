meta {
  name: Logout
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/logout
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

headers {
  Accept: application/json
}

script:post-response {
  if (res.status === 204) {
    bru.setEnvVar("token", "");
  }
}

tests {
  test("logs out (204)", function () {
    expect(res.status).to.equal(204);
  });
}