includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/nesbot/carbon/extension.neon

parameters:
    paths:
        - app/
        - bootstrap/app.php
        - config/
        - database/
        - routes/

    level: 7

    ignoreErrors:
        # Used by Livewire pages in resources/views, which PHPStan does not scan.
        -
            identifier: trait.unused
            path: app/Livewire/Concerns/*